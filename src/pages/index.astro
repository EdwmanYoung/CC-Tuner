---
import "../styles/tokens.css";
import "../styles/globals.css";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CC-Tuner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- 标题栏 -->
  <header class="title-bar">
    <span class="app-name">CC-Tuner</span>
    <div class="window-controls">
      <button class="win-btn" data-action="minimize" aria-label="Minimize">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
      </button>
      <button class="win-btn" data-action="maximize" aria-label="Maximize">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
      </button>
      <button class="win-btn close" data-action="close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </header>

  <!-- 主容器 -->
  <div class="main-container">
    <!-- 侧边导航 -->
    <nav class="side-nav" id="sideNav">
      <div class="side-nav-header">配置方案</div>
      <ul class="nav-list">
        <li class="nav-item active" data-page="profiles">
          <span class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg></span>
          <span class="nav-label">配置管理</span>
        </li>
        <li class="nav-item" data-page="history">
          <span class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg></span>
          <span class="nav-label">操作历史</span>
        </li>
        <li class="nav-item" data-page="settings">
          <span class="nav-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72l-.01.44a2 2 0 0 0 1.82 1.83l.19.02a2 2 0 0 1 1.71.99l.22.38a2 2 0 0 0 2.73.73l.38-.22a2 2 0 0 1 2.73.73l.09.15a2 2 0 0 1-.73 2.73l-.1.15a2 2 0 0 1-1.72 1l-.44.01a2 2 0 0 0-1.82 1.82l-.02.19a2 2 0 0 1-.99 1.71l-.38.22a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.09a2 2 0 0 1 2.73-.73l.38-.22a2 2 0 0 1 2.73.73l.09.15a2 2 0 0 1-.73 2.73l-.1.15a2 2 0 0 1-1.72 1l-.44-.01a2 2 0 0 0-1.82-1.82l.02-.19a2 2 0 0 1-.99-1.71l-.38-.22a2 2 0 0 0-.73-2.73l-.22.38a2 2 0 0 0 2.73.73l.15-.09a2 2 0 0 1 2.73-.73l.38-.22a2 2 0 0 1 2.73.73l.09.15a2 2 0 0 1-.73 2.73l-.1.15a2 2 0 0 1-1.72 1l-.44.01a2 2 0 0 0-1.82 1.82l-.02.19a2 2 0 0 1-.99 1.71l-.38.22a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.09a2 2 0 0 1 2.73-.73l.38-.22a2 2 0 0 1 2.73.73l.09.15a2 2 0 0 1-.73 2.73l-.1.15a2 2 0 0 1-1.72 1"/></svg></span>
          <span class="nav-label">设置</span>
        </li>
      </ul>
      <div class="side-nav-footer">
        <button class="theme-toggle" id="themeToggle">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          切换主题
        </button>
      </div>
    </nav>

    <!-- 主内容区 -->
    <main class="content-area">
      <!-- 命令栏 -->
      <div class="command-bar">
        <input class="search-input" type="text" id="searchInput" placeholder="搜索配置方案..." />
        <button class="btn btn-primary pill" id="newProfileBtn">
          <span class="btn-icon">+</span> 新建方案
        </button>
        <button class="btn pill" id="launchClaudeBtn">
          启动 Claude Code
        </button>
      </div>

      <!-- 页面：配置管理 -->
      <div class="page active" id="page-profiles">
        <div class="cards-grid" id="cardsContainer"></div>
      </div>

      <!-- 页面：编辑器 -->
      <div class="page" id="page-editor">
        <div class="editor-container" id="editorContainer"></div>
      </div>

      <!-- 页面：详情 -->
      <div class="page" id="page-detail">
        <div class="detail-container" id="detailContainer"></div>
      </div>

      <!-- 页面：历史 -->
      <div class="page" id="page-history">
        <div class="history-container" id="historyContainer"></div>
      </div>

      <!-- 页面：设置 -->
      <div class="page" id="page-settings">
        <div class="settings-container" id="settingsContainer"></div>
      </div>
    </main>
  </div>

  <!-- 状态栏 -->
  <footer class="status-bar">
    <span>当前激活：<strong id="activeProfileName">无</strong></span>
    <span class="separator">|</span>
    <span id="statusMessage">就绪</span>
  </footer>

  <!-- Toast 容器 -->
  <div id="toastContainer" class="toast-container"></div>

  <!-- 配置引导弹窗（未设置配置目录时显示） -->
  <div class="overlay" id="setupOverlay">
    <div class="setup-dialog">
      <div class="setup-icon"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg></div>
      <h2>欢迎使用 CC-Tuner</h2>
      <p class="setup-desc">
        请配置 Claude Code 设置文件所在的项目根目录。<br/>
        该目录应包含 <code>.claude/settings.json</code> 文件。
      </p>
      <div class="setup-actions">
        <button class="btn btn-primary pill" id="setupConfigBtn">配置目录</button>
        <button class="btn pill" id="setupSkipBtn">暂不配置</button>
      </div>
    </div>
  </div>

  <script type="module" src="/js/app.js"></script>
</body>
</html>
